{
  "name": "iqra2-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start:backend": "pnpm --filter backend start:prod",
    "start:frontend": "pnpm --filter frontend start",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "postinstall": "pnpm --filter backend exec prisma generate"
  },
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "turbo": "latest"
  }
}
