{
  "name": "iqra2-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "postinstall": "cd backend && npx prisma generate",
    "dev": "pnpm --parallel --recursive run dev",
    "build": "pnpm --recursive run build",
    "start": "pnpm --parallel --recursive run start"
  }
}
