// Prisma Schema - Sistem Informasi SD IT Iqra 2 Kota Bengkulu (CMS Only)
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// MODUL AUTENTIKASI & USER MANAGEMENT
// ============================================================

enum Role {
  SUPER_ADMIN
  KEPALA_SEKOLAH
  ADMIN_HUMAS
}

model User {
  id        String    @id
  name      String
  email     String    @unique
  role      Role      @default(ADMIN_HUMAS)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relasi
  posts          Post[]
  pages          Page[]
  uploadedMedia  Media[]

  @@map("users")
}

// ============================================================
// MODUL CMS (PROFIL SEKOLAH)
// ============================================================

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String?
  content     String     @db.Text
  coverImage  String?    
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?  

  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id])

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("posts")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  posts       Post[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

model Page {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  content     String     @db.Text
  status      PageStatus @default(DRAFT)
  sortOrder   Int        @default(0)

  authorId    String
  author      User       @relation(fields: [authorId], references: [id])

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("pages")
}

// ============================================================
// MODUL MEDIA & GALERI
// ============================================================

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  path         String
  url          String
  mimeType     String
  size         Int
  
  cloudinaryId String?  
  cloudinaryUrl String? 

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  createdAt    DateTime @default(now())

  @@map("media")
}

model GalleryItem {
  id           String   @id @default(cuid())
  title        String
  description  String?
  imageUrl     String
  cloudinaryId String?  
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("gallery_items")
}

// ============================================================
// MODUL PENGATURAN SITUS (SITE SETTINGS)
// ============================================================

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text 
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ============================================================
// MODUL MENU NAVIGASI
// ============================================================

model MenuItem {
  id          String   @id @default(cuid())
  label       String
  url         String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  openInNewTab Boolean @default(false)

  parentId    String?                     
  parent      MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id])
  children    MenuItem[] @relation("MenuHierarchy")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("menu_items")
}
