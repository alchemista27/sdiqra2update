# URL dan Port
NEXT_PUBLIC_API_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Database Prisma (Ganti dengan kredensial PostgreSQL Anda)
DATABASE_URL=postgresql://username:password@host.aws.neon.tech/dbname?sslmode=require

# Autentikasi JWT
JWT_SECRET=super_secret_jwt_key_example
JWT_EXPIRES_IN=7d

# Konfigurasi Cloudinary (Untuk Upload Media)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
